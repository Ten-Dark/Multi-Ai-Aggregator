{
  "manifest_version": 2,
  "name": "Multi-AI Aggregator Bridge",
  "version": "0.3.9",
  "description": "Local bridge between Multi-AI Aggregator and ChatGPT, Qwen and DeepSeek tabs in Zen.",
  "browser_specific_settings": {
    "gecko": {
      "id": "multi-ai-aggregator@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["personalCommunications", "websiteContent", "browsingActivity"]
      },
      "update_url": "https://github.com/Ten-Dark/Multi-Ai-Aggregator/releases/latest/download/updates.json"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "tabs",
    "cookies",
    "http://127.0.0.1/*",
    "https://chatgpt.com/*",
    "https://chat.qwen.ai/*",
    "https://chat.deepseek.com/*",
    "https://api.github.com/*",
    "https://github.com/*"
  ],
  "background": {
    "scripts": [
      "reconnect-policy.js",
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Multi-AI Aggregator",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon.svg"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.qwen.ai/*",
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "content/submission.js",
        "content/automation.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
